# Optional: copy to .env. Existing shell variables take precedence.
# Or paste the key in the local app settings; it stays in server memory.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_CONTEXT_TOKENS=8192
KEV_MODEL=kev-latest
KEV_ENDPOINT=http://127.0.0.1:8009/v1/systemone
KEV_CONTEXT_TOKENS=8192
# KEV_API_KEY=  # only if you configured bearer auth on the Kev server
LAYA_MODEL=laya-multilingual
LAYA_ENDPOINT=http://127.0.0.1:8000/v1/systemone
CLM_MODEL=clm-mlx-bf16
CLM_ENDPOINT=http://127.0.0.1:8700/v1/systemone
# Optional Fuel iX OpenAI-compatible chat proxy (or enter in Model settings).
# FUELIX_BEARER_TOKEN=
# LLM_BASE_URL=https://your-fuelix-proxy.example/v1
LLM_MODEL=gpt-6-luna
LLM_CONTEXT_TOKENS=32768
LLM_REASONING_EFFORT=none
